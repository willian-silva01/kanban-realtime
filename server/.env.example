# ===========================================
# Kanban Realtime - Variáveis de Ambiente
# ===========================================

# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email (SMTP) — opcional ──────────────────────────────
# Deixe SMTP_HOST vazio para desabilitar o envio (o servidor avisa no startup).
#
# Gmail: ative a verificação em 2 etapas e gere uma "senha de app" em
#   https://myaccount.google.com/apppasswords — use-a em SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Outlook/Office 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#   (contas com 2FA também exigem senha de app).
# Porta 465 usa TLS direto; 587 usa STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@exemplo.com"

# URL pública do backend, usada nos links de descadastro dos e-mails.
# Padrão: http://localhost:$PORT
APP_URL=
